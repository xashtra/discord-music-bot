# Discord User Token (required)
DISCORD_TOKEN=your_token_here

# Owner Discord User ID (required)
OWNER_ID=your_user_id_here

# Default Admins (optional - comma separated IDs)
# These admins will survive server restarts
DEFAULT_ADMINS=id1,id2

# FFmpeg path (optional - auto-detected if on system PATH)
# Windows example: C:\path\to\ffmpeg.exe
# Linux/Server: leave blank or comment out
# FFMPEG_PATH=

# YouTube Netscape Cookie File Content (optional - bypasses 'Sign in to confirm you're not a bot' error)
# Export your cookies to Netscape format and paste the raw text here.
# Note: You can paste it directly or set it as a multi-line env variable on Railway!
# COOKIES_CONTENT=
